# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# --- Database ---------------------------------------------------------------
DB_NAME=task_register
DB_USER=task_register
# Used ONLY when the database volume is first created. To change it later you must
# reset the volume (docker compose down -v, deletes data) or change it inside PostgreSQL.
# Letters and digits are safest; if it contains $ wrap it in single quotes.
DB_PASSWORD=CHANGE-ME-long-random-db-password

# --- Django -----------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-50-character-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Local Docker Desktop runs on plain HTTP, so secure cookies are off here.
# Behind HTTPS in production set: DJANGO_SECURE_COOKIES=true, DJANGO_SECURE_SSL_REDIRECT=true, DJANGO_HSTS_SECONDS=31536000
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# --- Demo data and trial users ---------------------------------------------
# true loads 20 sample tasks and 7 trial users on first start (never in production).
SEED_DEMO=true
# Shared password for all trial users. Leave empty to have a random one printed in the backend log.
DEMO_USER_PASSWORD=CHANGE-ME-Trial-2026

# --- Microsoft Entra ID sign-in (optional) ---------------------------------
OIDC_ENABLED=false
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Ports and images -------------------------------------------------------
APP_PORT=8080
# For images built by GitHub Actions: IMAGE_PREFIX=ghcr.io/<owner>/<repo>  IMAGE_TAG=latest
IMAGE_PREFIX=task-register
IMAGE_TAG=local
