# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# --- Database ---------------------------------------------------------------
DB_NAME=task_register
DB_USER=task_register
# Used ONLY when the database volume is first created. To change it later you must
# reset the volume (docker compose down -v, deletes data) or change it inside PostgreSQL.
# Letters and digits are safest; if it contains $ wrap it in single quotes.
DB_PASSWORD=CHANGE-ME-long-random-db-password

# --- Django -----------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-50-character-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Local Docker Desktop runs on plain HTTP, so secure cookies are off here.
# Behind HTTPS in production set: DJANGO_SECURE_COOKIES=true, DJANGO_SECURE_SSL_REDIRECT=true, DJANGO_HSTS_SECONDS=31536000
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
# Trusted reverse proxies in front of the API (1 = the nginx web container). Lets rate limits and the
# sign-in lockout see each client's address. Leave 0 when the API is reached directly.
DJANGO_NUM_PROXIES=1
# Sign-in lockout: failed attempts before a lock, and its length in minutes.
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Sessions end after this many idle minutes, and at the latest this many hours after sign-in.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=10
# The OpenAPI description at /api/docs/ (Administrators only). Set false to switch it off.
API_DOCS_ENABLED=true
# Days the System issues page keeps errors and warnings.
SYSTEM_EVENT_RETENTION_DAYS=90

# --- Demo data and trial users ---------------------------------------------
# true loads 20 sample tasks and 7 trial users on first start (never in production).
# Load the organisation's work groups, directions, sub-objectives and members, with a sign-in account
# for each member (missing records only; edits made in Configuration are kept).
LOAD_INITIAL_DATA=true
# First password of those accounts. Leave empty to keep their sign-in off until an Admin sets a password
# or they use Microsoft Entra ID. Users change it themselves from the menu (Change password).
INITIAL_USER_PASSWORD=
SEED_DEMO=true
# Shared password for all trial users. Leave empty to have a random one printed in the backend log.
DEMO_USER_PASSWORD=CHANGE-ME-Trial-2026

# --- Microsoft Entra ID sign-in (optional) ---------------------------------
OIDC_ENABLED=false
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Ports and images -------------------------------------------------------
APP_PORT=8080
# For images built by GitHub Actions: IMAGE_PREFIX=ghcr.io/<owner>/<repo>  IMAGE_TAG=latest
IMAGE_PREFIX=task-register
IMAGE_TAG=local

# Outgoing email: sign-in codes and delegation notices. It can also be set on Administration > System settings
# (that setting wins while it is switched on there).
# Without EMAIL_HOST no email is sent and the email code at sign-in cannot be switched on.
# Microsoft 365: EMAIL_HOST=smtp.office365.com, EMAIL_PORT=587, EMAIL_USE_TLS=true, a mailbox allowed to send.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=TMO Task Register <no-reply@al-ayuni.com>
# The application's address, for links in emails, e.g. https://task-register.al-ayuni.com
APP_PUBLIC_URL=
